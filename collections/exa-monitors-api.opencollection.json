              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Updates a monitor configuration."
        },
        {
          "info": {
            "name": "Delete Monitor",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.exa.ai/v0/monitors/:id",
            "params": [
              {
                "name": "id",
