{
  "opencollection": "1.0.0",
  "info": {
    "name": "Exa Agent Search API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exa.ai/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Perform a search with an Exa prompt-engineered query and retrieve a list of relevant results. Optionally get contents."
        }
      ]
    }
  ],
  "bundled": true
}