{
  "opencollection": "1.0.0",
  "info": {
    "name": "Exa Agent Contents API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Contents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exa.ai/contents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Contents"
        }
      ]
    }
  ],
  "bundled": true
}